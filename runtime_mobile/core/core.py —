from runtime_mobile.core.event_types import MobileEvent
from runtime_mobile.core.event_types import MobileEventTypes


class MobileRuntimeCore:
    """
    Main orchestrator for the GAMA mobile runtime.
    Initializes the runtime context, dispatcher and processes events.
    """

    def __init__(self, context, dispatcher):
        self.context = context
        self.dispatcher = dispatcher

    def initialize(self):
        """
        Initializes the mobile runtime.
        Loads context modules and registers dispatcher handlers.
        """
        self.context.load()
        self.dispatcher.register_handlers()

    def handle_event(self, event: MobileEvent):
        """
        Processes an event through the dispatcher.
        Updates runtime state accordingly.
        """
        # Update last event in context
        self.context.update_last_event(event.type)

        # Dispatch event to the correct module
        result = self.dispatcher.dispatch(event)

        return result
